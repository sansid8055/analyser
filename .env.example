# ============================================================
# Weekly Product Review Pulse — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- OpenAI (Embeddings) ---
# API key for OpenAI text-embedding-3-small
OPENAI_API_KEY=your_openai_api_key_here

# --- Groq (LLM Summarization) ---
# API key for Groq llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# --- MCP Server ---
# URL of the external MCP server (mcp-server-saksham)
# Default: http://localhost:8000
MCP_SERVER_URL=http://localhost:8000
